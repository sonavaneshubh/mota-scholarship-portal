# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Required. Without it the app cannot reach the database.
VITE_SUPABASE_URL=

# Public, browser-safe Supabase key. Current name is the publishable key; the
# older anon key is accepted as a fallback. Either one is fine — both are designed
# to be public and are protected by Row Level Security.
#
# Never put a service-role / secret key in this file. It must not reach a
# frontend build.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=
