# Editor / local tooling config (may contain machine-specific paths or API keys)
.vscode/

# TypeScript incremental build cache
*.tsbuildinfo

# Downloaded Stitch design exports (reference artifacts, not source)
stitch_*/

# Supabase CLI local project linkage (project ref, pooler host, linked project
# name, cached component versions). Machine-local state regenerated by
# `supabase link`, not source — the tracked files are config.toml + migrations.
supabase/.temp/

# Scratch folder holding the original scheme guideline PDFs. The served copies
# live in mota-scholarship-portal-frontend/public/guidelines/ and are committed
# from there, so this folder would only duplicate ~9.7 MB in the history.
mota-scholarship-portal-frontend/GR PDF/

# Stray `supabase init` scaffold inside the frontend package. Running the
# Supabase CLI from mota-scholarship-portal-frontend/ rather than the repo root
# generated a second config.toml whose project_id is the frontend directory
# name, not the real project ref (mciwgsdthqjaadtzuthq). The canonical config is
# the tracked supabase/config.toml at the repo root.
mota-scholarship-portal-frontend/supabase/

# Local debug output from a failed `supabase` CLI invocation. Regenerated by
# re-running the command; machine-local, never source.
supabase-debug.txt

# Timestamped copies of supabase/config.toml taken while repairing its parse
# error. Kept locally as a rollback aid, but they are duplicates of the tracked
# config and would only cause confusing merge conflicts.
supabase/config.toml.backup
supabase/config.toml.before-fix
supabase/config.toml.broken
supabase/config.toml.full-backup
